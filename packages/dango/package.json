{
  "name": "@mr-quin/dango",
  "version": "0.5.0",
  "description": "Declarative danmaku source manifest engine",
  "author": "Mr-Quin",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Quin/dango.git",
    "directory": "packages/dango"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "fast-xml-parser": "^4.5.1",
    "js-md5": "^0.8.3",
    "jsonata": "^2.0.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {}
}
