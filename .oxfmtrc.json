{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 80,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "bun.lock",
    "bun.lockb",
    "**/__tests__/fixtures/**"
  ]
}
