{
  "name": "dango-workspace",
  "private": true,
  "type": "module",
  "description": "Declarative danmaku source manifest engine and built-in manifests",
  "author": "Mr-Quin",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@mr-quin/dango' build",
    "type-check": "bun run --filter '*' type-check",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run build && bun run type-check && bun run lint && bun run format:check && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-md5": "^0.7.2",
    "oxfmt": "^0.53.0",
    "oxlint": "^0.15.0",
    "typescript": "^6.0.3"
  }
}
